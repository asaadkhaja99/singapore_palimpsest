GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3-pro-preview
GEMINI_RESEARCH_MODEL=gemini-3-pro-preview
GEMINI_EXTRACTION_MODEL=gemini-3-flash-preview
GEMINI_POI_MODEL=gemini-3-flash-preview
GEMINI_ANCHOR_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_FAST_IMAGE_MODEL=gemini-3.1-flash-image-preview
SKIP_VISION_DETECTION=true
PREFER_CACHED_STREETLEVEL=true
USE_CACHED_STREETLEVEL_FALLBACK=true
CACHED_STREETLEVEL_MAX_DISTANCE_M=350
FAST_LANDMARK_RESEARCH=false
AREA_RESEARCH_ENABLED=true
AREA_RESEARCH_TIMEOUT_S=8
AREA_RESEARCH_MAX_CHARS=18000
FAST_POI_ENRICHMENT=true
IMAGE_GENERATION_CONCURRENCY=4
IMAGE_GENERATION_START_INTERVAL_S=0.5
GRABMAPS_API_KEY=
GRABMAPS_BASE_URL=https://maps.grab.com
PALIMPSEST_DB_PATH=./palimpsest.db
PALIMPSEST_IMG_DIR=./static/img
PALIMPSEST_LOG_LEVEL=INFO
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GRABMAPS_API_KEY=
